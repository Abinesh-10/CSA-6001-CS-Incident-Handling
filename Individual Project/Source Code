                f"Required (≤{tier.external_notification_deadline_hours}h): {', '.join(tier.external_bodies)}"
                if tier.external_notification_required and tier.external_notification_deadline_hours
                else ("Contingent: " + ", ".join(tier.external_bodies) if tier.external_notification_required
                      else "Not required")
            ),
        })
    df = pd.DataFrame(rows)
    return df


# ------------------------------------------------------------------------
# 3. INCIDENT LIFECYCLE MODEL
# ------------------------------------------------------------------------
class IncidentStatus(str, Enum):
    OPEN = "Open"
    ACKNOWLEDGED = "Acknowledged"
    ESCALATED = "Escalated"
    CONTAINED = "Contained"
    RESOLVED = "Resolved"


@dataclass
class Incident:
    incident_id: str
    title: str
    severity: Severity
    detected_at: datetime
    status: IncidentStatus = IncidentStatus.OPEN
    current_tier: Severity = None
    acknowledged_at: Optional[datetime] = None
    resolved_at: Optional[datetime] = None
    escalation_log: List[str] = field(default_factory=list)
    communication_log: List[str] = field(default_factory=list)
    external_notification_sent: bool = False

    def __post_init__(self):
        if self.current_tier is None:
            self.current_tier = self.severity

    # -- convenience metrics -----------------------------------------
    def time_to_ack_minutes(self) -> Optional[float]:
        if self.acknowledged_at is None:
            return None
        return (self.acknowledged_at - self.detected_at).total_seconds() / 60

    def time_to_resolve_hours(self) -> Optional[float]:
        if self.resolved_at is None:
            return None
        return (self.resolved_at - self.detected_at).total_seconds() / 3600


# ------------------------------------------------------------------------
# 4. THE ESCALATION / COMMUNICATION ENGINE
# ------------------------------------------------------------------------
class IncidentEscalationEngine:
    """
    Drives incidents through the escalation matrix, fires the right
    communication channels at the right tier, auto-escalates breached
    SLAs, and tracks external/regulatory notification obligations.
    """

    def __init__(self, matrix: Dict[Severity, EscalationTier]):
        self.matrix = matrix
        self.incidents: Dict[str, Incident] = {}
        self.audit_trail: List[str] = []

    # ---- logging -----------------------------------------------------
    def _log(self, msg: str):
        self.audit_trail.append(msg)

    # ---- incident intake ----------------------------------------------
    def report_incident(self, incident_id: str, title: str, severity: Severity,
                         detected_at: datetime) -> Incident:
        inc = Incident(incident_id=incident_id, title=title, severity=severity,
                        detected_at=detected_at)
        self.incidents[incident_id] = inc
        tier = self.matrix[inc.current_tier]
        self._notify(inc, tier, event="INCIDENT REPORTED")
        self._log(f"[{detected_at:%Y-%m-%d %H:%M}] {incident_id} reported "
                   f"({severity.label()}) -> routed to {tier.primary_owner}")
        return inc

    # ---- communication --------------------------------------------------
    def _notify(self, inc: Incident, tier: EscalationTier, event: str):
        for ch in tier.channels:
            entry = f"{event}: {inc.incident_id} via [{ch.value}] -> {tier.escalation_contact}"
            inc.communication_log.append(entry)

    # ---- acknowledgement -------------------------------------------------
    def acknowledge(self, incident_id: str, ack_time: datetime, by: str):
        inc = self.incidents[incident_id]
        inc.acknowledged_at = ack_time
        inc.status = IncidentStatus.ACKNOWLEDGED
        self._log(f"[{ack_time:%Y-%m-%d %H:%M}] {incident_id} acknowledged by {by} "
                   f"(after {inc.time_to_ack_minutes():.1f} min)")

    # ---- SLA sweep / auto-escalation --------------------------------------
    def check_and_escalate(self, now: datetime):
        """Call periodically (e.g. every minute in a real system) to auto-escalate
        any incident whose acknowledgement SLA has been breached."""
        for inc in self.incidents.values():
            if inc.status not in (IncidentStatus.OPEN,):
                continue
            tier = self.matrix[inc.current_tier]
            elapsed = (now - inc.detected_at).total_seconds() / 60
            if elapsed > tier.auto_escalate_after_minutes and inc.acknowledged_at is None:
                self._escalate(inc, now)

    def _escalate(self, inc: Incident, now: datetime):
        prev_sev = inc.current_tier
        # escalate to the next-more-severe tier that still exists (never below SEV1)
        new_level = max(1, int(prev_sev) - 1)
        new_sev = Severity(new_level)
        inc.current_tier = new_sev
        inc.status = IncidentStatus.ESCALATED
        tier = self.matrix[new_sev]
        inc.escalation_log.append(
            f"{now:%Y-%m-%d %H:%M} auto-escalated {prev_sev.label()} -> {new_sev.label()} "
            f"(ack SLA breached) -> now owned by {tier.escalation_contact}"
        )
        self._notify(inc, tier, event="AUTO-ESCALATION (SLA BREACH)")
        self._log(f"[{now:%Y-%m-%d %H:%M}] {inc.incident_id} ESCALATED "
                   f"{prev_sev.label()} -> {new_sev.label()}")
        self._check_external_notification(inc, now)

    # ---- external / regulatory notification -------------------------------
    def _check_external_notification(self, inc: Incident, now: datetime):
        tier = self.matrix[inc.current_tier]
        if tier.external_notification_required and not inc.external_notification_sent:
            inc.external_notification_sent = True
            inc.communication_log.append(
                f"EXTERNAL NOTIFICATION triggered for {inc.incident_id}: "
                f"{', '.join(tier.external_bodies)} "
                f"(deadline {tier.external_notification_deadline_hours}h from detection)"
                if tier.external_notification_deadline_hours else
                f"EXTERNAL NOTIFICATION (contingent) queued for {inc.incident_id}: "
                f"{', '.join(tier.external_bodies)}"
            )
            self._log(f"[{now:%Y-%m-%d %H:%M}] {inc.incident_id} -> external "
                       f"notification workflow triggered")

    # ---- resolution --------------------------------------------------
    def resolve(self, incident_id: str, resolved_at: datetime):
        inc = self.incidents[incident_id]
        inc.resolved_at = resolved_at
        inc.status = IncidentStatus.RESOLVED
        self._log(f"[{resolved_at:%Y-%m-%d %H:%M}] {incident_id} RESOLVED "
                   f"(total time {inc.time_to_resolve_hours():.2f} h)")

    # ---- reporting --------------------------------------------------
    def summary_dataframe(self) -> pd.DataFrame:
        rows = []
        for inc in self.incidents.values():
            tier = self.matrix[inc.severity]
            rows.append({
                "Incident ID": inc.incident_id,
                "Title": inc.title,
                "Initial Severity": inc.severity.label(),
                "Final Tier": inc.current_tier.label(),
                "Status": inc.status.value,
                "Ack SLA (min)": tier.ack_sla_minutes,
                "Time to Ack (min)": round(inc.time_to_ack_minutes(), 1) if inc.time_to_ack_minutes() is not None else None,
                "SLA Breached": (inc.time_to_ack_minutes() is None or
                                 inc.time_to_ack_minutes() > tier.ack_sla_minutes),
                "Escalated": len(inc.escalation_log) > 0,
                "Time to Resolve (h)": round(inc.time_to_resolve_hours(), 2) if inc.time_to_resolve_hours() is not None else None,
                "External Notification": inc.external_notification_sent,
            })
        return pd.DataFrame(rows)


# ------------------------------------------------------------------------
# 5. SIMULATION — generate a realistic incident stream and run it
#    through the engine to validate the framework end-to-end.
# ------------------------------------------------------------------------
def simulate(n_incidents: int = 60, seed: int = 42) -> "tuple[IncidentEscalationEngine, pd.DataFrame]":
    random.seed(seed)
    engine = IncidentEscalationEngine(ESCALATION_MATRIX)

    start = datetime(2026, 1, 6, 9, 0)
    severities = list(Severity)
    # Realistic mix: most alerts are low/medium, few are true SEV1 crises
    weights = {Severity.SEV1_CRITICAL: 0.05, Severity.SEV2_HIGH: 0.15,
               Severity.SEV3_MEDIUM: 0.35, Severity.SEV4_LOW: 0.45}

    incident_titles = {
        Severity.SEV1_CRITICAL: ["Ransomware encryption detected on file server",
                                  "Confirmed data exfiltration via C2 channel",
                                  "Domain controller compromised"],
        Severity.SEV2_HIGH: ["Malware outbreak on endpoint subnet",
                              "Unauthorized privileged account use",
                              "Web application SQLi exploitation attempt (successful)"],
        Severity.SEV3_MEDIUM: ["Targeted phishing campaign against finance team",
                                "Policy violation: unencrypted USB transfer",
                                "Suspicious lateral movement alert"],
        Severity.SEV4_LOW: ["Repeated failed VPN logins",
                             "Informational IDS signature match",
                             "False-positive AV detection"],
    }

    for i in range(1, n_incidents + 1):
        sev = random.choices(severities, weights=[weights[s] for s in severities])[0]
        detected_at = start + timedelta(minutes=random.randint(0, 60 * 24 * 14))  # 2-week window
        inc_id = f"INC-{2026}{i:04d}"
        title = random.choice(incident_titles[sev])
        engine.report_incident(inc_id, title, sev, detected_at)

        tier = ESCALATION_MATRIX[sev]

        # Simulate human response behaviour: mostly within SLA, occasionally late
        # (later severities are staffed less tightly -> slightly higher breach chance)
        breach_prob = {Severity.SEV1_CRITICAL: 0.08, Severity.SEV2_HIGH: 0.15,
                        Severity.SEV3_MEDIUM: 0.20, Severity.SEV4_LOW: 0.30}[sev]

        if random.random() < breach_prob:
            # Analyst is late -> ack happens after auto-escalate would have fired
            ack_delay = tier.auto_escalate_after_minutes + random.randint(5, 90)
            # run the SLA sweep at the escalation boundary to trigger auto-escalation
            engine.check_and_escalate(detected_at + timedelta(minutes=tier.auto_escalate_after_minutes + 1))
        else:
            ack_delay = random.randint(1, tier.ack_sla_minutes)

        ack_time = detected_at + timedelta(minutes=ack_delay)
        engine.acknowledge(inc_id, ack_time, by=tier.primary_owner)

        resolve_hours = np.random.gamma(shape=2.0, scale=tier.resolution_target_hours / 2.5)
        resolve_time = ack_time + timedelta(hours=max(0.25, resolve_hours))
        engine.resolve(inc_id, resolve_time)

    df = engine.summary_dataframe()
    return engine, df


