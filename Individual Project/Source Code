# ------------------------------------------------------------------------
# 8. COMMUNICATION-FAILURE COMPARISON: matrix vs no-matrix (baseline)
#    Demonstrates the "reduces delays and communication failures" claim
#    quantitatively, by simulating a naive baseline (single flat queue,
#    single channel, no auto-escalation) against the tiered framework.
# ------------------------------------------------------------------------
def simulate_baseline(n_incidents: int = 60, seed: int = 42) -> pd.DataFrame:
    """A naive baseline: every incident, regardless of severity, sits in one
    email queue and is handled first-come-first-served with a flat 60-minute
    'best effort' SLA and no auto-escalation -- representative of many real
    organisations before a formal matrix is introduced."""
    random.seed(seed + 1)
    np.random.seed(seed + 1)
    start = datetime(2026, 1, 6, 9, 0)
    severities = list(Severity)
    weights = {Severity.SEV1_CRITICAL: 0.05, Severity.SEV2_HIGH: 0.15,
               Severity.SEV3_MEDIUM: 0.35, Severity.SEV4_LOW: 0.45}
    rows = []
    for i in range(1, n_incidents + 1):
        sev = random.choices(severities, weights=[weights[s] for s in severities])[0]
        detected_at = start + timedelta(minutes=random.randint(0, 60 * 24 * 14))
        flat_sla = 60  # single undifferentiated SLA, no severity-aware routing
        ack_delay = max(1, np.random.exponential(scale=45))  # queued FCFS, noisy
        breached = ack_delay > (ESCALATION_MATRIX[sev].ack_sla_minutes)  # judged against the *real* need
        resolve_hours = np.random.gamma(shape=2.2, scale=ESCALATION_MATRIX[sev].resolution_target_hours / 1.6)
        rows.append({
            "Incident ID": f"BASE-{i:04d}",
            "Initial Severity": sev.label(),
            "Time to Ack (min)": round(ack_delay, 1),
            "SLA Breached": bool(breached),
            "Time to Resolve (h)": round(resolve_hours, 2),
        })
    return pd.DataFrame(rows)


def plot_framework_comparison(matrix_df: pd.DataFrame, baseline_df: pd.DataFrame, outpath: str):
    order = ["SEV-1 Critical", "SEV-2 High", "SEV-3 Medium", "SEV-4 Low"]
    m = matrix_df.groupby("Initial Severity")["SLA Breached"].mean().reindex(order) * 100
    b = baseline_df.groupby("Initial Severity")["SLA Breached"].mean().reindex(order) * 100

    x = np.arange(len(order))
    width = 0.35
    fig, ax = plt.subplots(figsize=(8, 4.8))
    ax.bar(x - width / 2, b.values, width, label="Baseline (flat queue, no matrix)", color="#95A5A6")
    ax.bar(x + width / 2, m.values, width, label="Proposed Escalation Matrix", color="#2ECC71")
    ax.set_xticks(x)
    ax.set_xticklabels(order)
    ax.set_ylabel("SLA Breach Rate (%)")
    ax.set_title("SLA Breach Rate: Baseline vs Proposed Framework")
    ax.legend()
    plt.tight_layout()
    plt.savefig(outpath, dpi=150)
    plt.show()


