def plot_escalation_matrix_heatmap(outpath: str):
    """A visual heat-map of the matrix itself: rows=severity, cols=response
    metric. Colour encodes URGENCY (red = tightest deadline / most urgent,
    green = most relaxed), normalised independently per column since the
    three metrics live on very different scales (minutes vs. hours)."""
    sevs = list(ESCALATION_MATRIX.keys())
    labels = [s.label() for s in sevs]
    metrics = ["Ack SLA (min)", "Auto-escalate (min)", "Resolution Target (hr)"]
    raw = np.array([
        [ESCALATION_MATRIX[s].ack_sla_minutes,
         ESCALATION_MATRIX[s].auto_escalate_after_minutes,
         ESCALATION_MATRIX[s].resolution_target_hours * 60]  # minutes, shared scale for normalisation only
        for s in sevs
    ], dtype=float)

    # Per-column min-max normalisation, then invert so SMALLER (tighter) time
    # -> urgency close to 1 (red); LARGER (more relaxed) time -> urgency close to 0 (green).
    col_min = raw.min(axis=0)
    col_max = raw.max(axis=0)
    normalised = (raw - col_min) / (col_max - col_min + 1e-9)
    urgency = 1 - normalised

    fig, ax = plt.subplots(figsize=(7, 4.5))
    im = ax.imshow(urgency, cmap="RdYlGn_r", aspect="auto", vmin=0, vmax=1)
    ax.set_xticks(range(len(metrics)))
    ax.set_xticklabels(metrics, rotation=15, ha="right")
    ax.set_yticks(range(len(labels)))
    ax.set_yticklabels(labels)
    for i in range(len(labels)):
        for j in range(len(metrics)):
            val = raw[i, j]
            txt = f"{val:.0f}" if j != 2 else f"{val/60:.0f}h"
            # pick readable text colour against the cell's urgency shade
            text_color = "white" if urgency[i, j] > 0.7 else "black"
            ax.text(j, i, txt, ha="center", va="center", color=text_color, fontsize=9)
    ax.set_title("Escalation Matrix Urgency Heat-map (red = most urgent)")
    fig.colorbar(im, ax=ax, label="Relative urgency (per-column normalised)")
    plt.tight_layout()
    plt.savefig(outpath, dpi=150)
    plt.show()


