    for sev, tier in ESCALATION_MATRIX.items():
        rows.append({
            "Severity": sev.label(),
            "Primary Owner": tier.primary_owner,
            "Ack. SLA (min)": tier.ack_sla_minutes,
            "Resolution Target (hrs)": tier.resolution_target_hours,
            "Auto-escalate after (min)": tier.auto_escalate_after_minutes,
            "Escalates To": tier.escalation_contact,
            "Comm. Channels": ", ".join(c.value for c in tier.channels),
            "Management Involvement": tier.management_involvement,
