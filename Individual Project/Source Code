# 1. DOMAIN MODEL — SEVERITY LEVELS
# ------------------------------------------------------------------------
class Severity(IntEnum):
    """Lower integer = higher severity (SEV1 is worst)."""
    SEV1_CRITICAL = 1   # e.g. active ransomware, data exfiltration, outage of core service
    SEV2_HIGH     = 2   # e.g. confirmed intrusion contained to one segment, malware outbreak
    SEV3_MEDIUM   = 3   # e.g. phishing campaign, policy violation, suspicious anomaly
    SEV4_LOW      = 4   # e.g. informational alert, failed login spikes, false-positive triage

    def label(self) -> str:
        return {
            Severity.SEV1_CRITICAL: "SEV-1 Critical",
            Severity.SEV2_HIGH:     "SEV-2 High",
            Severity.SEV3_MEDIUM:   "SEV-3 Medium",
            Severity.SEV4_LOW:      "SEV-4 Low",
        }[self]


class Channel(str, Enum):
    PAGERDUTY   = "PagerDuty / SIEM auto-page"
    PHONE       = "Direct phone call"
    SMS         = "SMS / push alert"
    SLACK_WAR   = "Slack #incident-warroom (bridge)"
    EMAIL       = "Email (distribution list)"
    STATUS_PAGE = "Internal status page update"
    PRESS       = "Press release / PR statement"
    REGULATOR   = "Regulator notification portal"


