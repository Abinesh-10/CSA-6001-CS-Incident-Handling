# 6. METRICS
# ------------------------------------------------------------------------
def compute_kpis(df: pd.DataFrame) -> pd.DataFrame:
    grouped = df.groupby("Initial Severity").agg(
        Incidents=("Incident ID", "count"),
        Mean_Time_To_Ack_min=("Time to Ack (min)", "mean"),
        SLA_Breach_Rate_pct=("SLA Breached", lambda s: 100 * s.mean()),
        Escalation_Rate_pct=("Escalated", lambda s: 100 * s.mean()),
        Mean_Time_To_Resolve_hr=("Time to Resolve (h)", "mean"),
    ).round(2)
    order = ["SEV-1 Critical", "SEV-2 High", "SEV-3 Medium", "SEV-4 Low"]
    grouped = grouped.reindex(order)
    return grouped


